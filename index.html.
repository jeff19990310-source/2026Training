<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>115學年度桃園市國小中外師培訓共識營 - 簽到與祝福系統</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome 圖示 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&display=swap');
    body { font-family: 'Noto Sans TC', sans-serif; }

    /* 文字彈幕跑馬燈樣式 */
    .danmu-text {
      position: absolute;
      white-space: nowrap;
      animation: float-left linear forwards;
      pointer-events: auto;
      transition: transform 0.2s;
    }

    .danmu-text:hover {
      transform: scale(1.05);
      z-index: 50;
    }

    /* 從右至左飄移動畫 */
    @keyframes float-left {
      0% { right: -100%; opacity: 0; }
      3% { opacity: 1; }
      97% { opacity: 1; }
      100% { right: 100%; opacity: 0; }
    }
  </style>
</head>
<body class="bg-slate-900 text-white min-h-screen flex flex-col">

  <!-- 頂部控制列 (深藍主題) -->
  <header class="bg-blue-950 text-white shadow-xl sticky top-0 z-50 border-b border-blue-800">
    <div class="max-w-7xl mx-auto px-4 py-3.5 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <i class="fa-solid fa-graduation-cap text-sky-400 text-2xl"></i>
        <h1 id="nav-title" class="text-base sm:text-lg font-bold tracking-wide text-white">115學年度桃園市國小中外師培訓共識營</h1>
      </div>
      
      <div class="flex items-center gap-3">
        <!-- 頁面切換按鈕 -->
        <button id="togglePageBtn" class="bg-blue-800 hover:bg-blue-700 text-sky-200 border border-blue-600 px-4 py-1.5 rounded-lg text-sm font-medium transition flex items-center gap-2 shadow-sm">
          <i class="fa-solid fa-tv"></i>
          <span id="btn-toggle-page">切換至祝福牆</span>
        </button>

        <!-- 雙語切換按鈕 -->
        <button id="toggleLangBtn" class="bg-sky-500 hover:bg-sky-400 text-blue-950 font-bold px-3.5 py-1.5 rounded-lg text-sm transition flex items-center gap-1.5 shadow-sm">
          <i class="fa-solid fa-globe"></i>
          <span id="btn-lang-label">English</span>
        </button>
      </div>
    </div>
  </header>

  <!-- 頁面 1：簽到與留言填寫頁面 (藍白質感配色) -->
  <main id="page-signin" class="flex-1 max-w-xl w-full mx-auto p-4 sm:p-6 flex flex-col justify-center">
    <div class="bg-blue-900/60 backdrop-blur-md rounded-2xl shadow-2xl border border-blue-700/50 overflow-hidden">
      <div class="bg-blue-950 p-6 text-center border-b border-blue-800">
        <span class="bg-sky-400 text-blue-950 text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wider">Welcome</span>
        <h2 id="signin-header" class="text-2xl font-bold mt-2 text-white">賓客簽到與祝福</h2>
        <p id="signin-sub" class="text-sky-200 text-sm mt-1">請填寫您的基本資料並留下祝福語</p>
      </div>

      <form id="checkinForm" class="p-6 space-y-5">
        <div>
          <label id="label-name" class="block text-sm font-medium text-sky-100 mb-1.5">您的姓名 / Name *</label>
          <input type="text" id="userName" required placeholder="例如：王大明 / David Smith" 
                 class="w-full px-4 py-2.5 bg-blue-950/80 border border-blue-700 rounded-xl focus:ring-2 focus:ring-sky-400 focus:outline-none transition text-sm text-white placeholder-blue-300/50">
        </div>

        <div>
          <label id="label-role" class="block text-sm font-medium text-sky-100 mb-1.5">身分與職稱 / Role *</label>
          <select id="userRole" class="w-full px-4 py-2.5 bg-blue-950/80 border border-blue-700 rounded-xl focus:ring-2 focus:ring-sky-400 focus:outline-none transition text-sm text-white">
            <option value="校長 (Principal)" class="bg-blue-950 text-white">校長 / Principal</option>
            <option value="主任 (Director)" class="bg-blue-950 text-white">主任 / Director</option>
            <option value="組長 (Section Chief)" class="bg-blue-950 text-white">組長 / Section Chief</option>
            <option value="老師 (Teacher)" class="bg-blue-950 text-white">老師 / Teacher</option>
            <option value="Foreign Teacher" class="bg-blue-950 text-white">Foreign Teacher</option>
          </select>
        </div>

        <div>
          <label id="label-message" class="block text-sm font-medium text-sky-100 mb-1.5">祝福與勉勵語 / Wishes & Encouragement *</label>
          <textarea id="blessingText" rows="4" required placeholder="寫下對團隊或新學期的祝福..." 
                    class="w-full px-4 py-2.5 bg-blue-950/80 border border-blue-700 rounded-xl focus:ring-2 focus:ring-sky-400 focus:outline-none transition resize-none text-sm text-white placeholder-blue-300/50"></textarea>
        </div>

        <button type="submit" class="w-full bg-sky-500 hover:bg-sky-400 text-blue-950 font-bold py-3 rounded-xl transition shadow-lg flex justify-center items-center gap-2 text-base">
          <i class="fa-solid fa-paper-plane"></i>
          <span id="btn-submit">完成簽到並送出祝福</span>
        </button>
      </form>
    </div>
  </main>

  <!-- 頁面 2：文字跑馬燈展示牆 (藍底白字質感風) -->
  <main id="page-wall" class="flex-1 relative hidden overflow-hidden bg-gradient-to-b from-blue-950 via-slate-900 to-blue-950">
    <!-- 文字彈幕容器 -->
    <div id="danmuContainer" class="absolute inset-0 overflow-hidden"></div>

    <!-- 底部資訊提示 -->
    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-blue-900/80 backdrop-blur-md px-6 py-2.5 rounded-full shadow-lg border border-blue-700/60 text-xs text-sky-200 flex items-center gap-2 z-10">
      <i class="fa-solid fa-circle-info text-sky-400"></i>
      <span id="wall-footer-tip">祝福留言將持續以文字跑馬燈形式展示</span>
    </div>
  </main>

  <script>
    // 預設資料庫
    let messages = [
      { name: "張校長", role: "校長 (Principal)", text: "祝福115學年度桃園市中外師團隊合作無間，共創佳績！" },
      { name: "John Smith", role: "Foreign Teacher", text: "Wishing all teachers a successful workshop and academic year!" },
      { name: "林主任", role: "主任 (Director)", text: "熱烈歡迎各位老師參與雙語培訓共識營，大家加油！" },
      { name: "陳老師", role: "老師 (Teacher)", text: "期待新學期的協同教學，齊心為桃園雙語教育努力！" }
    ];

    let currentLang = 'zh'; // 'zh' 或 'en'
    let isWallPage = false;
    let danmuTimer = null;

    // 雙語翻譯設定
    const i18n = {
      zh: {
        title: "115學年度桃園市國小中外師培訓共識營",
        toWall: "切換至祝福牆",
        toSignin: "切換至簽到頁",
        signinHeader: "賓客簽到與祝福",
        signinSub: "請填寫您的基本資料並留下祝福語",
        nameLabel: "您的姓名 / Name *",
        roleLabel: "身分與職稱 / Role *",
        messageLabel: "祝福與勉勵語 / Wishes & Encouragement *",
        submitBtn: "完成簽到並送出祝福",
        wallTip: "祝福留言將持續以文字跑馬燈形式展示",
        successMsg: "簽到成功！您的祝福已成功送出。"
      },
      en: {
        title: "2026 Taoyuan City Elementary Schools Bilingual Teachers Training Camp",
        toWall: "Switch to Wall",
        toSignin: "Switch to Sign-in",
        signinHeader: "Guest Check-in & Blessings",
        signinSub: "Please fill in your details and leave a blessing",
        nameLabel: "Name *",
        roleLabel: "Role *",
        messageLabel: "Wishes & Encouragement *",
        submitBtn: "Complete Check-in & Submit",
        wallTip: "Messages will float across the screen as text stream",
        successMsg: "Check-in successful! Your blessing has been sent."
      }
    };

    // DOM 元素引用
    const togglePageBtn = document.getElementById('togglePageBtn');
    const toggleLangBtn = document.getElementById('toggleLangBtn');
    const pageSignin = document.getElementById('page-signin');
    const pageWall = document.getElementById('page-wall');
    const checkinForm = document.getElementById('checkinForm');
    const danmuContainer = document.getElementById('danmuContainer');

    // 語言切換
    function updateLanguage() {
      const lang = i18n[currentLang];
      document.getElementById('nav-title').textContent = lang.title;
      document.getElementById('btn-toggle-page').textContent = isWallPage ? lang.toSignin : lang.toWall;
      document.getElementById('btn-lang-label').textContent = currentLang === 'zh' ? 'English' : '繁體中文';
      
      document.getElementById('signin-header').textContent = lang.signinHeader;
      document.getElementById('signin-sub').textContent = lang.signinSub;
      document.getElementById('label-name').textContent = lang.nameLabel;
      document.getElementById('label-role').textContent = lang.roleLabel;
      document.getElementById('label-message').textContent = lang.messageLabel;
      document.getElementById('btn-submit').textContent = lang.submitBtn;
      document.getElementById('wall-footer-tip').textContent = lang.wallTip;
    }

    // 頁面切換
    function togglePage() {
      isWallPage = !isWallPage;
      if (isWallPage) {
        pageSignin.classList.add('hidden');
        pageWall.classList.remove('hidden');
        startDanmuLoop();
      } else {
        pageWall.classList.add('hidden');
        pageSignin.classList.remove('hidden');
        stopDanmuLoop();
      }
      updateLanguage();
    }

    // HTML 轉義
    function escapeHtml(str) {
      return str.replace(/[&<>"']/g, function(m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m];
      });
    }

    // 生成純文字跑馬燈 (文字為主的卡片式彈幕)
    function spawnDanmu(data) {
      if (!isWallPage) return;

      const danmu = document.createElement('div');
      danmu.className = 'danmu-text bg-blue-900/80 text-white px-5 py-2.5 rounded-full border border-sky-400/50 shadow-lg flex items-center gap-3';
      
      // 隨機垂直位置 (top) 8% ~ 82%
      const topPos = (Math.random() * 74 + 8).toFixed(1);
      // 隨機飄移時間 16s ~ 26s
      const duration = (Math.random() * 10 + 16).toFixed(1);

      danmu.style.top = `${topPos}%`;
      danmu.style.animationDuration = `${duration}s`;

      // 依據角色設定徽章配色
      let badgeColor = "bg-sky-400 text-blue-950";
      if (data.role.includes("Foreign")) badgeColor = "bg-amber-400 text-blue-950";
      if (data.role.includes("校長") || data.role.includes("主任")) badgeColor = "bg-emerald-400 text-blue-950";

      danmu.innerHTML = `
        <span class="text-xs font-extrabold px-2.5 py-0.5 rounded-full ${badgeColor}">
          ${escapeHtml(data.role)}
        </span>
        <span class="font-bold text-sky-200 text-sm sm:text-base">${escapeHtml(data.name)}:</span>
        <span class="text-white text-sm sm:text-base font-normal">${escapeHtml(data.text)}</span>
      `;

      danmuContainer.appendChild(danmu);

      // 動畫結束後自動清理 DOM 元素
      setTimeout(() => {
        danmu.remove();
      }, parseFloat(duration) * 1000);
    }

    // 輪播觸發器
    function startDanmuLoop() {
      danmuContainer.innerHTML = '';
      if (messages.length > 0) {
        spawnDanmu(messages[0]);
      }
      
      danmuTimer = setInterval(() => {
        if (messages.length > 0) {
          const randomIndex = Math.floor(Math.random() * messages.length);
          spawnDanmu(messages[randomIndex]);
        }
      }, 3000); // 每 3 秒發送一條彈幕
    }

    function stopDanmuLoop() {
      if (danmuTimer) clearInterval(danmuTimer);
    }

    // 表單送出
    checkinForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('userName').value.trim();
      const role = document.getElementById('userRole').value;
      const text = document.getElementById('blessingText').value.trim();

      if (!name || !text) return;

      const newMsg = { name, role, text };
      messages.unshift(newMsg);

      alert(i18n[currentLang].successMsg);
      checkinForm.reset();

      // 自動切換到展示牆並發送該條彈幕
      togglePage();
      spawnDanmu(newMsg);
    });

    // 事件監聽
    togglePageBtn.addEventListener('click', togglePage);
    toggleLangBtn.addEventListener('click', () => {
      currentLang = currentLang === 'zh' ? 'en' : 'zh';
      updateLanguage();
    });

    // 初始化
    updateLanguage();
  </script>
</body>
</html>
